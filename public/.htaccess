# ============================================================
# Concept Autos POS — Root .htaccess
# Location: public_html/.htaccess
# Deployed at: https://honeydew-sparrow-441252.hostingersite.com/
# ============================================================

# ------------------------------------------------------------
# Disable directory listing (safer than Options -Indexes)
# ------------------------------------------------------------
IndexIgnore *

# ------------------------------------------------------------
# Default index file
# ------------------------------------------------------------
DirectoryIndex index.html

# ------------------------------------------------------------
# CUSTOM ERROR PAGE
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
# BLOCK SENSITIVE FILES & FOLDERS
# ------------------------------------------------------------
<FilesMatch "^\.env.*$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.git.*$">
    Require all denied
</FilesMatch>

<FilesMatch "^(package(-lock)?\.json|tsconfig\.json|next\.config\.(ts|js)|postcss\.config\.mjs|eslint\.config\.mjs|README\.md)$">
    Require all denied
</FilesMatch>

# Hide .next, node_modules, .git folders
RedirectMatch 403 ^/\.next/.*$
RedirectMatch 403 ^/node_modules/.*$
RedirectMatch 403 ^/\.git/.*$

# ------------------------------------------------------------
# REWRITE RULES
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Allow CORS preflight OPTIONS through untouched ---
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [L]

    # --- Let API requests pass through to PHP untouched ---
    RewriteRule ^api/ - [L]

    # --- If the request maps to a real file or folder, serve it ---
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- SPA fallback: try /path/index.html ---
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # --- Otherwise: let 404.html handle it (do NOT redirect to home) ---
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [L,R=404]
</IfModule>

# ------------------------------------------------------------
# SECURITY HEADERS
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Uncomment once HTTPS is enforced:
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------------
# CACHING — Next.js hashed assets (long cache)
# ------------------------------------------------------------
<IfModule mod_headers.c>
    # Hashed static assets from /_next/static — 1 year immutable
    <FilesMatch "\.(js|css|woff|woff2|ttf|eot|svg|png|jpg|jpeg|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML — always revalidate
    <FilesMatch "\.html?$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # API & JSON — never cache
    <FilesMatch "\.(json|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript        "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpg              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------
# GZIP COMPRESSION
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
# UTF-8 (safe wrapper)
# ------------------------------------------------------------
<IfModule mod_charset_lite.c>
    AddDefaultCharset UTF-8
</IfModule>

# ------------------------------------------------------------
# MIME TYPES
# ------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/json .json
    AddType application/manifest+json .webmanifest
</IfModule>